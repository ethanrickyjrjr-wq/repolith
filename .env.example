# Copy this file to .env.local and fill in values. .env.local is gitignored.
#
# repolith's CLI does not consume any API keys today (it only shells out to git).
# These are placeholders for features added later — uncomment as needed.

# GITHUB_TOKEN=                 # for GitHub API enrichment (future)
# ANTHROPIC_API_KEY=           # for LLM-powered commands (future)
# REPOLITH_CONCURRENCY=8       # parallel git process cap (already supported)
